# ============================================================
# 环境变量模板 — 复制为 .env 并填入真实值
#   cp .env.example .env
# ============================================================

# DeepSeek LLM
# 从 https://platform.deepseek.com/api_keys 获取
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# OpenAI
# 从 https://platform.openai.com/api-keys 获取
OPENAI_API_KEY=

# Zhipu (智谱 GLM)
# 从 https://open.bigmodel.cn 获取
ZHIPU_API_KEY=your-zhipu-api-key
ZHIPU_MODEL=glm-5.1
ZHIPU_EMBEDDING_MODEL=embedding-3
ZHIPU_EMBEDDING_URL=https://open.bigmodel.cn/api/paas/v4/embeddings
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=32

# Alibaba Cloud (DashScope)
# 从 https://bailian.console.aliyun.com 获取
ALI_API_KEY=
ALI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
ALI_CHAT_MODEL=qwen-plus
ALI_EMBEDDING_MODEL=text-embedding-v3

# Provider selection
LLM_PROVIDER=deepseek
EMBEDDING_PROVIDER=zhipu

# llama-parse
# 从 https://cloud.llamaindex.ai 获取
LLAMA_CLOUD_API_KEY=

# PostgreSQL / pgvector
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ai_assistant
PG_USER=postgres
PG_PASSWORD=your-db-password

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage (MinIO / S3)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key
S3_BUCKET=ai-documents

# SSL
SSL_VERIFY=true
SSL_CERT_BUNDLE=

# Retrieval (RAG / reranker)
RETRIEVAL_MODE=hybrid
RETRIEVAL_COARSE_K=40
RETRIEVAL_FINE_K=5
RETRIEVAL_SHORT_QUERY_BOOST=10
RETRIEVAL_SHORT_QUERY_LEN=15
RETRIEVAL_STAGE1_THRESHOLD=0.65
RETRIEVAL_STAGE2_THRESHOLD=0.0
RERANK_ENABLED=true
RERANK_MIN_SCORE=0.0

# Chat context
CHAT_MAX_ROUNDS=30
CHAT_CONTEXT_TOKENS=8000
CHAT_PAGE_SIZE=20

# Summarization
CHAT_SUMMARIZE_TRIGGER=200
CHAT_SUMMARIZE_KEEP_RECENT=20

# Chunking
CHUNK_STRATEGY=sentence
CHUNK_SIZE=1024
CHUNK_OVERLAP=100
SENTENCE_WINDOW_ENABLED=false
SENTENCE_WINDOW_AUTO_THRESHOLD=20

# Two-level retrieval (document summary index)
SUMMARY_SEARCH_TOP_K=3
TWO_STAGE_MIN_DOCS=10

# JWT
# ⚠️ 生产环境必须更换为随机强密钥（至少32字符）
JWT_SECRET=change-me-in-production-must-be-32-chars!

# App
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=DEBUG

# Paths
DATA_DIR=data
PROMPTS_DIR=prompts
MODELS_CACHE_DIR=data/models
